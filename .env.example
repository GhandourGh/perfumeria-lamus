# Used only when starting with a brand-new database.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_NAME=Store Owner
INITIAL_ADMIN_PASSWORD=replace-with-at-least-12-characters
INITIAL_ADMIN_SECURITY_QUESTION=What is your private recovery phrase?
INITIAL_ADMIN_SECURITY_ANSWER=replace-with-a-private-answer

# Optional: when omitted, a private key is generated under instance/.
SECRET_KEY=

# Optional local overrides.
# PERFUMERIA_DB=perfumeria_lamus.db
# FLASK_DEBUG=0

# Backup email credentials are configured privately inside the app.
# Never put a Gmail password or app password in this file or in GitHub.
